# 复制本文件为 .env 后填写；.env 已被 .gitignore 排除，切勿提交。
# 生成强随机密钥：
#   python3 -c "import secrets; print('JWT_SECRET=' + secrets.token_urlsafe(48))"
#   python3 -c "import pyotp; print('OTP_SECRET=' + pyotp.random_base32())"
# OTP_SECRET 需要导入验证器 App（Base32）；容器日志不会回显该密钥。
# 更换 OTP_SECRET 后，所有已绑定的动态口令都会失效，需重新绑定。
JWT_SECRET=
OTP_SECRET=

# 可选：构建镜像时的 HTTP 代理（境内网络 pip 官方源较慢时使用）。
# 代理账号密码只允许写在本地 .env，不要写进 Dockerfile 或提交到仓库。
# 例：http://user:password@proxy-host:port
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
